{% extends 'members/base.html' %}

{% block title %}Gym Members - Dashboard{% endblock %}

{% block navbar_center %}{% endblock %}

{% block navbar_actions %}
{% if user.is_authenticated %}
    <li class="nav-item">
        <form method="get" class="d-flex me-2">
            <input type="text" name="search" class="form-control me-1" placeholder="Search members..." value="{{ search_query }}" style="width: 200px; height: 31px;">
            <button type="submit" class="btn btn-outline-primary btn-sm" aria-label="Search">
                <i class="fas fa-search"></i>
            </button>
            {% if search_query %}
                <a href="?sort_by={{ sort_by }}&direction={{ direction }}" class="btn btn-outline-secondary btn-sm ms-1" aria-label="Clear">
                    <i class="fas fa-times"></i>
                </a>
            {% endif %}
        </form>
    </li>
    <li class="nav-item">
        <button type="button" class="btn btn-outline-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#addMemberModal" aria-label="Add Member">
            <i class="fas fa-user-plus me-1"></i>
        </button>
    </li>
    <li class="nav-item">
        <button type="button" class="btn btn-outline-info btn-sm me-2" data-bs-toggle="modal" data-bs-target="#importExcelModal" aria-label="Import from Excel">
            <i class="fas fa-file-import me-1"></i>Import
        </button>
    </li>
    <li class="nav-item">
        <a href="{% url 'export_excel' %}" class="btn btn-outline-success btn-sm me-2" aria-label="Export to Excel">
            <i class="fas fa-file-excel me-1"></i>Export
        </a>
    </li>
{% endif %}
{% endblock %}

{% block content %}
<style>
.dashboard-card {
    border-radius: 15px;
    transition: all 0.3s ease;
    overflow: hidden;
    position: relative;
    border: 2px solid transparent;
    background: transparent;
    box-shadow: none;
    margin-bottom: 1rem;
}

.dashboard-card:nth-child(1) {
    border-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%) 1;
}

.dashboard-card:nth-child(2) {
    border-image: linear-gradient(135deg, #4CAF50 0%, #45a049 100%) 1;
}

.dashboard-card:nth-child(3) {
    border-image: linear-gradient(135deg, #FF9800 0%, #F57C00 100%) 1;
}

.dashboard-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.dashboard-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.dashboard-card:hover::before {
    opacity: 0.1;
}

.icon-wrapper {
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.1rem auto;
    transition: all 0.3s ease;
}

.dashboard-card:hover .icon-wrapper {
    background: rgba(255,255,255,0.3);
    transform: scale(1.05);
}

.dashboard-card .card-title {
    font-size: 1.2rem;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    font-weight: 700;
    margin-bottom: 0.05rem;
}

.dashboard-card .card-text {
    text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    font-weight: 500;
    font-size: 0.75rem;
}

.content-wrapper {
    padding: 2rem;
    margin: 0;
    width: 100%;
}

.table td, .table th {
    padding: 0.15rem 0.3rem;
    vertical-align: middle;
    font-size: 0.8rem;
}

.table-responsive {
    max-height: 35vh;
    overflow-y: auto;
}

@media (max-width: 768px) {
    .content-wrapper {
        margin: 0.5rem !important;
        padding: 0.5rem !important;
    }

    .dashboard-card {
        margin-bottom: 0.5rem;
    }

    .table-responsive {
        max-height: 50vh;
    }
}
</style>
<div class="content-wrapper">
    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endif %}
    <div class="text-center mb-2">
        <h1 class="mb-0"><i class="fas fa-dumbbell me-2"></i>Gym Members Dashboard</h1>
        <!-- <p class="text-muted">Manage gym members efficiently</p> -->
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4 justify-content-center">
        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body text-center text-dark">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-users fa-3x"></i>
                    </div>
                    <h2 class="card-title mb-1">{{ total_members }}</h2>
                    <p class="card-text mb-0">Total Members</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body text-center text-dark">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-user-check fa-3x"></i>
                    </div>
                    <h2 class="card-title mb-1">{{ active_members }}</h2>
                    <p class="card-text mb-0">Active Members</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body text-center text-dark">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-user-times fa-3x"></i>
                    </div>
                    <h2 class="card-title mb-1">{{ inactive_members }}</h2>
                    <p class="card-text mb-0">Inactive Members</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Membership Type Distribution -->
    {% if membership_types %}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Membership Type Distribution</h5>
        </div>
        <div class="card-body">
            <div class="row">
                {% for type in membership_types %}
                <div class="col-md-4 mb-3">
                    <div class="text-center">
                        <h6>{{ type.membership_type }}</h6>
                        <div class="progress mb-2" style="height: 20px;">
                        <div class="progress-bar bg-primary" role="progressbar"
                             style="width: {% widthratio type.count total_members 100 %}%"
                             aria-valuenow="{{ type.count }}" aria-valuemin="0" aria-valuemax="{{ total_members }}">
                            {{ type.count }}
                        </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

        {% if not search_query and not members %}
            <div class="text-center py-5">
                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No members yet</h4>
                <p class="text-muted">Start by adding your first gym member!</p>
            </div>
        {% endif %}
        {% if not search_query and not members %}
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>
                                <a href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by=name&direction={% if sort_by == 'name' and direction == 'asc' %}desc{% else %}asc{% endif %}" class="text-white text-decoration-none">
                                    <i class="fas fa-user me-2"></i>Name
                                    {% if sort_by == 'name' %}
                                        {% if direction == 'asc' %}
                                            <i class="fas fa-sort-up"></i>
                                        {% else %}
                                            <i class="fas fa-sort-down"></i>
                                        {% endif %}
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by=email&direction={% if sort_by == 'email' and direction == 'asc' %}desc{% else %}asc{% endif %}" class="text-white text-decoration-none">
                                    <i class="fas fa-envelope me-2"></i>Email
                                    {% if sort_by == 'email' %}
                                        {% if direction == 'asc' %}
                                            <i class="fas fa-sort-up"></i>
                                        {% else %}
                                            <i class="fas fa-sort-down"></i>
                                        {% endif %}
                                    {% endif %}
                                </a>
                            </th>
                            <th><i class="fas fa-phone me-2"></i>Phone</th>
                            <th><i class="fas fa-birthday-cake me-2"></i>D.O.B</th>
                            <th><i class="fas fa-venus-mars me-2"></i></th>
                            <th>
                                <a href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by=join_date&direction={% if sort_by == 'join_date' and direction == 'asc' %}desc{% else %}asc{% endif %}" class="text-white text-decoration-none">
                                    <i class="fas fa-calendar-alt me-2"></i>Joined On
                                    {% if sort_by == 'join_date' %}
                                        {% if direction == 'asc' %}
                                            <i class="fas fa-sort-up"></i>
                                        {% else %}
                                            <i class="fas fa-sort-down"></i>
                                        {% endif %}
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by=membership_type&direction={% if sort_by == 'membership_type' and direction == 'asc' %}desc{% else %}asc{% endif %}" class="text-white text-decoration-none">
                                    <i class="fas fa-id-card me-2"></i>Program
                                    {% if sort_by == 'membership_type' %}
                                        {% if direction == 'asc' %}
                                            <i class="fas fa-sort-up"></i>
                                        {% else %}
                                            <i class="fas fa-sort-down"></i>
                                        {% endif %}
                                    {% endif %}
                                </a>
                            </th>
                            <th><i class="fas fa-calendar-plus me-2"></i>Membership Start</th>
                            <th><i class="fas fa-calendar-times me-2"></i>Membership End</th>
                            <th>
                                <a href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by=is_active&direction={% if sort_by == 'is_active' and direction == 'asc' %}desc{% else %}asc{% endif %}" class="text-white text-decoration-none">
                                    <i class="fas fa-toggle-on me-2"></i>Status
                                    {% if sort_by == 'is_active' %}
                                        {% if direction == 'asc' %}
                                            <i class="fas fa-sort-up"></i>
                                        {% else %}
                                            <i class="fas fa-sort-down"></i>
                                        {% endif %}
                                    {% endif %}
                                </a>
                            </th>
                            <th><i class="fas fa-cogs me-2"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for member in members %}
                        <tr>
                            <td class="fw-bold text-primary">{{ member.name }}</td>
                            <td>{{ member.email }}</td>
                            <td>{{ member.phone_number|default:"-" }}</td>
                            <td>{{ member.dob|date:"d/m/Y"|default:"-" }}</td>
                            <td>
                                {% if member.gender == "Male" %}M{% elif member.gender == "Female" %}F{% elif member.gender == "Other" %}O{% else %}-{% endif %}
                            </td>
                            <td>{{ member.join_date|date:"d/m/Y" }}</td>
                            <td>
                                <span class="badge bg-secondary">{{ member.membership_type }}</span>
                            </td>
                            <td>{{ member.membership_start_date|date:"d/m/Y" }}</td>
                            <td>{{ member.membership_end_date|date:"d/m/Y" }}</td>
                            <td>
                                {% if member.is_active %}
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Active</span>
                                {% else %}
                                    <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Inactive</span>
                                {% endif %}
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-success me-2" data-bs-toggle="modal" data-bs-target="#generatePdfModal" onclick="generatePdf({{ member.id }}, '{{ member.name|escapejs }}', '{{ member.membership_type|escapejs }}', '{{ member.membership_start_date|date:"Y-m-d" }}', '{{ member.membership_end_date|date:"Y-m-d" }}', {{ member.is_active|lower }}, '{{ member.fees_amount|default:""|escapejs }}', '{{ member.payment_mode|default:""|escapejs }}', '{{ member.transaction_id|default:""|escapejs }}', '{{ member.comments|default:""|escapejs }}')" title="Generate Invoice PDF">
                                    <i class="fas fa-file-pdf"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#editMemberModal" onclick="editMember({{ member.id }}, '{{ member.name|escapejs }}', '{{ member.email|escapejs }}', '{{ member.phone_number|escapejs }}', '{{ member.dob|date:"Y-m-d"|default:"" }}', '{{ member.gender|escapejs }}', '{{ member.join_date|date:"Y-m-d" }}', '{{ member.membership_type|escapejs }}', '{{ member.membership_start_date|date:"Y-m-d" }}', '{{ member.membership_end_date|date:"Y-m-d" }}', {{ member.is_active|lower }})">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteMemberModal" onclick="setDeleteMember({{ member.id }}, '{{ member.name|escapejs }}')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        {% endfor %}
                        {% if not members and search_query %}
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">
                                <i class="fas fa-search me-2"></i>No members found matching "{{ search_query }}"
                            </td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            <!-- Pagination -->
            {% if members.has_other_pages %}
            <nav aria-label="Member list pagination">
                <ul class="pagination justify-content-center">
                    {% if members.has_previous %}
                        <li class="page-item">
                            <a class="page-link" href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by={{ sort_by }}&direction={{ direction }}&page=1" aria-label="First">
                                <span aria-hidden="true">&laquo;&laquo;</span>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by={{ sort_by }}&direction={{ direction }}&page={{ members.previous_page_number }}" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    {% endif %}
                    {% for num in members.paginator.page_range %}
                        {% if members.number == num %}
                            <li class="page-item active">
                                <span class="page-link">{{ num }}</span>
                            </li>
                        {% elif num > members.number|add:'-3' and num < members.number|add:'3' %}
                            <li class="page-item">
                                <a class="page-link" href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by={{ sort_by }}&direction={{ direction }}&page={{ num }}">{{ num }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                    {% if members.has_next %}
                        <li class="page-item">
                            <a class="page-link" href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by={{ sort_by }}&direction={{ direction }}&page={{ members.next_page_number }}" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="?{% if search_query %}search={{ search_query }}&{% endif %}sort_by={{ sort_by }}&direction={{ direction }}&page={{ members.paginator.num_pages }}" aria-label="Last">
                                <span aria-hidden="true">&raquo;&raquo;</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
            {% endif %}
        {% endif %}


    </div>



    <!-- Edit Member Modal -->
    <div class="modal fade" id="editMemberModal" tabindex="-1" aria-labelledby="editMemberModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <h5 class="modal-title" id="editMemberModalLabel">
                        <i class="fas fa-user-edit me-2"></i>Edit Member Details
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="update">
                    <input type="hidden" id="edit_member_id" name="member_id">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="edit_name" class="form-label">
                                    <i class="fas fa-user me-2"></i>Name
                                </label>
                                <input type="text" class="form-control form-control-lg" id="edit_name" name="name" required
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="edit_email" class="form-label">
                                    <i class="fas fa-envelope me-2"></i>Email
                                </label>
                                <input type="email" class="form-control form-control-lg" id="edit_email" name="email" required
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="edit_phone_number" class="form-label">
                                    <i class="fas fa-phone me-2"></i>Phone Number
                                </label>
                                <input type="tel" class="form-control form-control-lg" id="edit_phone_number" name="phone_number"
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="edit_dob" class="form-label">
                                    <i class="fas fa-birthday-cake me-2"></i>DOB
                                </label>
                                <input type="date" class="form-control form-control-lg" id="edit_dob" name="dob"
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="edit_gender" class="form-label">
                                    <i class="fas fa-venus-mars me-2"></i>Gender
                                </label>
                                <select class="form-select form-select-lg" id="edit_gender" name="gender"
                                        style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                                    <option value="">Choose...</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="edit_join_date" class="form-label">
                                    <i class="fas fa-calendar-alt me-2"></i>Join Date
                                </label>
                                <input type="date" class="form-control form-control-lg" id="edit_join_date" name="join_date" required
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="edit_membership_type" class="form-label">
                                    <i class="fas fa-id-card me-2"></i>Membership Type
                                </label>
                                <select class="form-select form-select-lg" id="edit_membership_type" name="membership_type" required
                                        style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                                    <option value="">Choose membership type...</option>
                                    <option value="strength">strength</option>
                                    <option value="cardio">cardio</option>
                                    <option value="crossfit">crossfit</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="edit_membership_start_date" class="form-label">
                                    <i class="fas fa-calendar-plus me-2"></i>Membership Start Date
                                </label>
                                <input type="date" class="form-control form-control-lg" id="edit_membership_start_date" name="membership_start_date" required
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="edit_membership_end_date" class="form-label">
                                    <i class="fas fa-calendar-times me-2"></i>Membership End Date
                                </label>
                                <input type="date" class="form-control form-control-lg" id="edit_membership_end_date" name="membership_end_date" required
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="edit_is_active" name="is_active">
                                    <label class="form-check-label" for="edit_is_active">
                                        <i class="fas fa-toggle-on me-2"></i>Is Active
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-save me-2"></i>Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Member Modal -->
    <div class="modal fade" id="deleteMemberModal" tabindex="-1" aria-labelledby="deleteMemberModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #f44336, #e57373); color: white;">
                    <h5 class="modal-title" id="deleteMemberModalLabel">
                        <i class="fas fa-trash-alt me-2"></i>Delete Member
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" id="delete_member_id" name="member_id">
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong id="delete_member_name"></strong>? This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Import Excel Modal -->
    <div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <h5 class="modal-title" id="importExcelModalLabel">
                        <i class="fas fa-file-import me-2"></i>Import Members from Excel
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" enctype="multipart/form-data" action="{% url 'import_excel' %}">
                    {% csrf_token %}
                    <div class="modal-body">
                        <p>Upload an Excel file (.xlsx) with member data. The file should have the following columns in order:</p>
                        <ul>
                            <li>Name</li>
                            <li>Email</li>
                            <li>Phone Number</li>
                            <li>Date of Birth (YYYY-MM-DD, optional)</li>
                            <li>Gender (Male/Female/Other, optional)</li>
                            <li>Join Date (YYYY-MM-DD)</li>
                            <li>Membership Type (strength/cardio/crossfit)</li>
                            <li>Membership Start Date (YYYY-MM-DD)</li>
                            <li>Membership End Date (YYYY-MM-DD)</li>
                            <li>Is Active (Yes/No)</li>
                        </ul>
                        <div class="mb-3">
                            <label for="excel_file" class="form-label">
                                <i class="fas fa-file-excel me-2"></i>Select Excel File
                            </label>
                            <input type="file" class="form-control" id="excel_file" name="excel_file" accept=".xlsx" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-upload me-2"></i>Import
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Generate PDF Modal -->
    <div class="modal fade" id="generatePdfModal" tabindex="-1" aria-labelledby="generatePdfModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <h5 class="modal-title" id="generatePdfModalLabel">
                        <i class="fas fa-file-pdf me-2"></i>Generate Invoice PDF
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" id="generatePdfForm" action="{% url 'generate_invoice_pdf' 0 %}" target="_blank"> target="_blank"
                    {% csrf_token %}
                    <input type="hidden" id="pdf_member_id" name="member_id">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="pdf_fees_amount" class="form-label">
                                    <i class="fas fa-rupee-sign me-2"></i>Fees Amount
                                </label>
                                <input type="number" step="0.01" class="form-control form-control-lg" id="pdf_fees_amount" name="fees_amount"
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="pdf_payment_mode" class="form-label">
                                    <i class="fas fa-credit-card me-2"></i>Payment Mode
                                </label>
                                <select class="form-select form-select-lg" id="pdf_payment_mode" name="payment_mode"
                                        style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                                    <option value="">Choose...</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Credit Card">Credit Card</option>
                                    <option value="Debit Card">Debit Card</option>
                                    <option value="UPI">UPI</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="pdf_transaction_id" class="form-label">
                                    <i class="fas fa-hashtag me-2"></i>Transaction ID
                                </label>
                                <input type="text" class="form-control form-control-lg" id="pdf_transaction_id" name="transaction_id"
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="pdf_membership_type" class="form-label">
                                    <i class="fas fa-id-card me-2"></i>Membership Type
                                </label>
                                <select class="form-select form-select-lg" id="pdf_membership_type" name="membership_type" required
                                        style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                                    <option value="">Choose membership type...</option>
                                    <option value="strength">strength</option>
                                    <option value="cardio">cardio</option>
                                    <option value="crossfit">crossfit</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="pdf_membership_start_date" class="form-label">
                                    <i class="fas fa-calendar-plus me-2"></i>Membership Start Date
                                </label>
                                <input type="date" class="form-control form-control-lg" id="pdf_membership_start_date" name="membership_start_date" required
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="pdf_membership_end_date" class="form-label">
                                    <i class="fas fa-calendar-times me-2"></i>Membership End Date
                                </label>
                                <input type="date" class="form-control form-control-lg" id="pdf_membership_end_date" name="membership_end_date" required
                                       style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="pdf_is_active" name="is_active">
                                    <label class="form-check-label" for="pdf_is_active">
                                        <i class="fas fa-toggle-on me-2"></i>Is Active
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label for="pdf_comments" class="form-label">
                                    <i class="fas fa-comment me-2"></i>Comments
                                </label>
                                <textarea class="form-control form-control-lg" id="pdf_comments" name="comments" rows="3"
                                          style="border-radius: 10px; border: 2px solid #e9ecef; transition: border-color 0.3s ease;"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-file-pdf me-2"></i>Generate PDF
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Focus on first input when modal opens
        const addMemberModal = document.getElementById('addMemberModal');
        if (addMemberModal) {
            addMemberModal.addEventListener('shown.bs.modal', function () {
                document.getElementById('modal_name').focus();
            });

            // Reset form when modal is closed
            addMemberModal.addEventListener('hidden.bs.modal', function () {
                document.querySelector('#addMemberModal form').reset();
            });
        }

        // Edit member function
        function editMember(id, name, email, phoneNumber, dob, gender, joinDate, membershipType, startDate, endDate, isActive) {
            document.getElementById('edit_member_id').value = id;
            document.getElementById('edit_name').value = name;
            document.getElementById('edit_email').value = email;
            document.getElementById('edit_phone_number').value = phoneNumber;
            document.getElementById('edit_dob').value = dob;
            document.getElementById('edit_gender').value = gender;
            document.getElementById('edit_join_date').value = joinDate;
            document.getElementById('edit_membership_type').value = membershipType;
            document.getElementById('edit_membership_start_date').value = startDate;
            document.getElementById('edit_membership_end_date').value = endDate;
            document.getElementById('edit_is_active').checked = isActive;
        }

        // Set delete member
        function setDeleteMember(id, name) {
            document.getElementById('delete_member_id').value = id;
            document.getElementById('delete_member_name').textContent = name;
        }

        // Reset edit form when modal is closed
        const editMemberModal = document.getElementById('editMemberModal');
        editMemberModal.addEventListener('hidden.bs.modal', function () {
            document.querySelector('#editMemberModal form').reset();
        });

        // Generate PDF function
        function generatePdf(id, name, membershipType, startDate, endDate, isActive, feesAmount, paymentMode, transactionId, comments) {
            document.getElementById('pdf_member_id').value = id;
            document.getElementById('pdf_membership_type').value = membershipType;
            document.getElementById('pdf_membership_start_date').value = startDate;
            document.getElementById('pdf_membership_end_date').value = endDate;
            document.getElementById('pdf_is_active').checked = isActive;
            document.getElementById('pdf_fees_amount').value = feesAmount;
            document.getElementById('pdf_payment_mode').value = paymentMode;
            document.getElementById('pdf_transaction_id').value = transactionId;
            document.getElementById('pdf_comments').value = comments;
            // Set form action dynamically
            document.getElementById('generatePdfForm').action = "{% url 'generate_invoice_pdf' 0 %}".replace('0', id);
        }

        // Reset PDF form when modal is closed
        const generatePdfModal = document.getElementById('generatePdfModal');
        generatePdfModal.addEventListener('hidden.bs.modal', function () {
            document.querySelector('#generatePdfModal form').reset();
        });
    </script>
{% endblock %}
